---
import type { CollectionEntry } from "astro:content";
import { severityLabels } from "../vocabulary.ts";

interface Props {
  rules: CollectionEntry<"rules">[];
}

const { rules } = Astro.props;
---

<ul class="rule-list">
  {
    rules.map((rule) => (
      <li>
        <a href={`/rules/${rule.data.ruleId}`}>
          <b>{rule.data.ruleId}</b>
          <span class="badge" data-severity={rule.data.severity}>
            {severityLabels[rule.data.severity]}
          </span>
          <p>{rule.data.description}</p>
        </a>
      </li>
    ))
  }
</ul>
