---
import styleURL from "../styles/global.css?url";
import { ogSlugForPath } from "../lib/og-path.ts";

export const SITE_NAME = "deadhead";
export const REPO = "https://github.com/cevdetta/deadhead";

interface Props {
  title: string;
  description: string;
  /** Rule pages are articles; the index pages are not. */
  ogType?: "website" | "article";
  publishedTime?: Date | undefined;
  /** True for pages with no lasting URL, like 404: no canonical, no og:url. */
  noindex?: boolean;
}

const { title, description, ogType = "website", publishedTime, noindex = false } = Astro.props;

const pageTitle = title === SITE_NAME ? title : `${title} · ${SITE_NAME}`;

// With `build.format: "file"`, Astro.url.pathname at build time is the emitted
// file (`/rules.html`, `/index.html`), not the URL it is served at. Left alone it
// puts `.html` in every canonical — a URL Cloudflare 308s away from — and no nav
// link ever matches the current page. Only the root index is special-cased, so
// a ruleId that happens to end in `index` still maps to its own page.
const path =
  Astro.url.pathname === "/index.html"
    ? "/"
    : Astro.url.pathname.replace(/\.html$/, "");
const canonical = new URL(path, Astro.site);
const ogImage = new URL(`/og/${ogSlugForPath(path)}.png`, Astro.site);

const nav = [
  { href: "/rules", label: "Rules" },
  { href: "/topics", label: "Topics" },
  { href: "/install", label: "Install" },
  { href: REPO, label: "GitHub" },
];

// This head is the project's own dogfood. `pnpm check:site` runs the CLI over
// the built output, so anything added here has to survive every rule in
// content/rules — charset in the first 1024 bytes, no X-UA-Compatible, no
// keywords, no `shortcut` in a rel, no type attribute on a classic script.
// The doctype is written out: Astro 7.3.4 skips its own when the head quotes
// `<!doctype html>`, as the document/doctype page's description does.
---

<Fragment set:html="<!doctype html>" />
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="color-scheme" content="dark light" />
    <link rel="stylesheet" href={styleURL} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/logo.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/app.webmanifest" />

    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && (
      <>
        <meta property="og:site_name" content={SITE_NAME} />
        <meta property="og:type" content={ogType} />
        <meta property="og:url" content={canonical} />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={ogImage} />
        {ogType === "article" && publishedTime && (
          <meta
            property="article:published_time"
            content={publishedTime.toISOString()}
          />
        )}
      </>
    )}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header>
      <a href="/" aria-current={path === "/" ? "page" : undefined}><img src="/logo.svg" alt="" width="20" height="20" />deadhead</a>
      <nav aria-label="Primary">
        {nav.map((item) => {
          const internal = item.href.startsWith("/");
          // "page" only for the page itself; "true" for its section (a rule under /rules).
          const current = !internal ? undefined : path === item.href ? "page" : path.startsWith(`${item.href}/`) ? "true" : undefined;
          return <a href={item.href} aria-current={current} rel={internal ? undefined : "external"}>{item.label}</a>;
        })}
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer>
      <p>
        Every rule is one markdown file in{" "}
        <a href={`${REPO}/tree/main/content/rules`}><code>content/rules/</code></a>. MIT licensed.{" "}
        <a href={REPO}>Source on GitHub</a>.
      </p>
    </footer>
  </body>
</html>
