---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Not found"
  description="I have no page at this address. Browse the rule index or return home."
>
  <article class="shell flow">
    <header class="flow">
      <h1>Not found</h1>
      <p class="lede">I have no page at this address.</p>
    </header>

    <p>
      You asked for a rule I do not publish, or a link I moved. Start at{" "}
      <a href="/rules">the rule index</a> and follow the namespaces, or return{" "}
      <a href="/">home</a>.
    </p>
  </article>
</Layout>
